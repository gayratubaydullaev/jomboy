# Example nginx config: Web (3000) + API (4000) behind one host.
# Copy to /etc/nginx/sites-available/myshopuz and adjust server_name + SSL paths.

upstream myshop_web {
  server 127.0.0.1:3000;
  keepalive 32;
}

upstream myshop_api {
  server 127.0.0.1:4000;
  keepalive 32;
}

server {
  listen 80;
  server_name myshop.uz www.myshop.uz;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl http2;
  server_name myshop.uz www.myshop.uz;

  # ssl_certificate /etc/letsencrypt/live/myshop.uz/fullchain.pem;
  # ssl_certificate_key /etc/letsencrypt/live/myshop.uz/privkey.pem;

  client_max_body_size 25m;

  location /api-proxy/ {
    proxy_pass http://myshop_api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    proxy_pass http://myshop_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
}
